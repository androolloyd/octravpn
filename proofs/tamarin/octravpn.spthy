/* Symbolic receipt authentication specification. This is not AML refinement.
   Opaque on-chain evidence is disabled in the release candidate. */
theory OctraVPNReceiptAuthentication
begin
builtins: signing, hashing

rule Register_Node:
  [ Fr(~n), Fr(~nk) ] --[ NodeRegistered(~n) ]->
  [ !Node(~n, ~nk), Out(<~n, pk(~nk)>) ]
rule Reveal_Node:
  [ !Node(n, nk) ] --[ NodeRevealed(n) ]-> [ Out(nk) ]
rule Open:
  [ !Node(n, nk), Fr(~s), Fr(~ck) ] --[ Opened(~s) ]->
  [ !Session(~s, n, ~ck), Out(<~s, n, pk(~ck)>) ]
rule Reveal_Client:
  [ !Session(s, n, ck) ] --[ ClientRevealed(s) ]-> [ Out(ck) ]
rule Sign_Client:
  let m = <'octravpn-receipt', s, n, seq, bytes>
  in
  [ !Session(s, n, ck), In(<seq, bytes>) ]
  --[ ClientSigned(s, seq, bytes) ]->
  [ Out(<'client', s, seq, bytes, sign(m, ck)>) ]
rule Sign_Node:
  let m = <'octravpn-receipt', s, n, seq, bytes>
  in
  [ !Session(s, n, ck), !Node(n, nk),
    In(<'client', s, seq, bytes, sign(m, ck)>) ]
  --[ NodeSigned(n, s, seq, bytes) ]->
  [ Out(<'dual', s, seq, bytes, sign(m, ck), sign(m, nk)>) ]
rule Accept_Receipt:
  let m = <'octravpn-receipt', s, n, seq, bytes>
  in
  [ !Session(s, n, ck), !Node(n, nk),
    In(<'dual', s, seq, bytes, sign(m, ck), sign(m, nk)>) ]
  --[ Accepted(n, s, seq, bytes) ]-> [ ]

lemma ClientAuthentication:
  "All n s seq b #i. Accepted(n,s,seq,b)@i ==>
     (Ex #j. ClientSigned(s,seq,b)@j & j < i) |
     (Ex #j. ClientRevealed(s)@j & j < i)"
lemma NodeAuthentication:
  "All n s seq b #i. Accepted(n,s,seq,b)@i ==>
     (Ex #j. NodeSigned(n,s,seq,b)@j & j < i) |
     (Ex #j. NodeRevealed(n)@j & j < i)"
lemma HonestReceiptReachable: exists-trace
  "Ex n s seq b #i. Accepted(n,s,seq,b)@i &
     not (Ex #j. ClientRevealed(s)@j) & not (Ex #j. NodeRevealed(n)@j)"
end

// Method fragments appended by `octra forge test --contract program/main-v4.aml`.
// Original production bodies are compiled unchanged. Each test has isolated VM state.
// Fixtures seed storage; transfers/native circle ownership need the live devnet gate.
private fn test_seed_circle() {
  self.min_circle_stake = 100000000
  self.unbond_grace_epochs = 1000
  self.circle_owner[caller] = caller
  self.circle_active[caller] = 1
  self.circle_state_version[caller] = 1
  self.circle_bond[caller] = 100000000
  self.circle_registration_approved[caller] = 1
  self.circle_authorized_owner[caller] = caller
}

// expect-revert test_retired_circle_cannot_be_reclaimed "circle already registered"
fn test_retired_circle_cannot_be_reclaimed(): bool {
  test_seed_circle()
  self.circle_active[caller] = 0
  self.circle_earnings_total[caller] = 500
  return register_circle(caller, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "fixture-key")
}

// expect-revert test_unapproved_registration_rejected "registration not approved"
fn test_unapproved_registration_rejected(): bool {
  self.min_circle_stake = 100000000
  return register_circle(caller, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "fixture-key")
}

// expect-revert test_wrong_approved_owner_rejected "not approved circle owner"
fn test_wrong_approved_owner_rejected(): bool {
  self.circle_registration_approved[caller] = 1
  return register_circle(caller, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "fixture-key")
}

// expect-revert test_approval_cannot_replace_registered_owner "circle already registered"
fn test_approval_cannot_replace_registered_owner(): bool {
  test_seed_circle()
  self.owner = caller
  return approve_circle_registration(caller, caller)
}

// expect-revert test_stake_required_at_registration "initial stake below minimum"
fn test_stake_required_at_registration(): bool {
  test_seed_circle()
  self.circle_active[caller] = 0
  self.circle_state_version[caller] = 0
  self.circle_bond[caller] = 0
  return register_circle(caller, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "fixture-key")
}

// expect-revert test_active_circle_cannot_unbond "retire circle before unbonding"
fn test_active_circle_cannot_unbond(): bool {
  test_seed_circle()
  return unbond_endpoint(caller)
}

fn test_retired_circle_stake_moves_to_slashable_unbond(): bool {
  test_seed_circle()
  require(retire_circle(caller), "retire failed")
  require(unbond_endpoint(caller), "unbond failed")
  require(self.circle_bond[caller] == 0, "live bond remains")
  require(self.circle_unbonding[caller] == 100000000, "stake disappeared")
  require(self.circle_unbond_unlock_epoch[caller] == epoch + 1000, "wrong unlock")
  require(!circle_is_active(caller), "unbonding operator active")
  return true
}

// expect-revert test_unbond_waits_for_funded_sessions "funded sessions still open"
fn test_unbond_waits_for_funded_sessions(): bool {
  test_seed_circle()
  self.circle_active[caller] = 0
  self.circle_open_sessions[caller] = 1
  self.circle_unbonding[caller] = 100000000
  self.circle_unbond_unlock_epoch[caller] = epoch
  return finalize_unbond(caller)
}

fn test_active_requires_minimum_stake(): bool {
  test_seed_circle()
  self.circle_bond[caller] = 99999999
  require(!circle_is_active(caller), "underfunded operator active")
  return true
}

fn test_active_rejects_unbonding(): bool {
  test_seed_circle()
  self.circle_unbonding[caller] = 1
  require(!circle_is_active(caller), "unbonding operator active")
  return true
}

// expect-revert test_opaque_signed_messages_cannot_slash "opaque slashing disabled; submit evidence to governance"
fn test_opaque_signed_messages_cannot_slash(): bool {
  test_seed_circle()
  return slash_double_sign(caller, "message-a", "signature-a", "message-b", "signature-b")
}

private fn test_seed_session(): uint {
  test_seed_circle()
  self.min_session_deposit = 1
  self.session_grace_epochs = 100
  self.sweep_grace_multiplier = 10
  self.tailnet_count = 1
  return write_session(0, caller, 100, 0)
}

fn test_open_tracks_outstanding_session(): bool {
  let sid = test_seed_session()
  require(self.circle_open_sessions[caller] == 1, "missing outstanding session")
  require(get_session_exit(sid) == caller, "operator binding wrong")
  require(get_session_opener(sid) == caller, "opener binding wrong")
  return true
}

fn test_confirm_closes_session_once_and_accounts_earnings(): bool {
  let sid = test_seed_session()
  self.operator_claim_set[sid] = 1
  self.operator_claim_bytes[sid] = 100
  self.protocol_fee_bps = 50
  self.session_deposit[sid] = 20000
  require(settle_confirm(sid, 100, 20000, "fixture"), "confirm failed")
  require(self.circle_open_sessions[caller] == 0, "outstanding session remains")
  require(self.session_status[sid] == SESSION_SETTLED, "session not settled")
  require(self.circle_earnings_total[caller] == 20000, "traffic payment was reduced")
  require(self.treasury == 0, "protocol commission collected")
  return true
}

// expect-revert test_terminal_session_cannot_close_twice "session not open"
fn test_terminal_session_cannot_close_twice(): bool {
  let sid = test_seed_session()
  self.operator_claim_set[sid] = 1
  self.operator_claim_bytes[sid] = 100
  require(settle_confirm(sid, 100, 100, "fixture"), "confirm failed")
  return settle_confirm(sid, 100, 100, "fixture")
}

fn test_dispute_preserves_session_and_stake_lock(): bool {
  let sid = test_seed_session()
  self.operator_claim_set[sid] = 1
  self.operator_claim_bytes[sid] = 100
  require(!settle_confirm(sid, 99, 100, "fixture"), "dispute accepted")
  require(self.session_status[sid] == SESSION_OPEN, "dispute prematurely terminal")
  require(self.circle_open_sessions[caller] == 1, "stake lock lost")
  return true
}

fn test_relay_claim_closes_session_and_accounts_earnings(): bool {
  let sid = test_seed_session()
  self.session_status[sid] = SESSION_RELAY_ARMED
  self.session_settlement_hash[sid] = sha256("receipt-preimage")
  self.session_relay_net[sid] = 100
  self.session_relay_deadline[sid] = epoch + 10
  require(relay_claim(sid, "receipt-preimage"), "claim failed")
  require(self.session_status[sid] == SESSION_RELAY_CLAIMED, "relay not terminal")
  require(self.circle_open_sessions[caller] == 0, "relay stake lock remains")
  require(self.circle_earnings_total[caller] == 100, "relay earnings wrong")
  return true
}

// expect-revert test_relay_claim_at_deadline_rejected "relay window elapsed; client may refund"
fn test_relay_claim_at_deadline_rejected(): bool {
  let sid = test_seed_session()
  self.session_status[sid] = SESSION_RELAY_ARMED
  self.session_relay_deadline[sid] = epoch
  return relay_claim(sid, "receipt-preimage")
}

// expect-revert test_session_exit_rejects_missing_session "session not found"
fn test_session_exit_rejects_missing_session(): bool {
  let unused = get_session_exit(0)
  return true
}

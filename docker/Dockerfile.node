FROM octravpn-builder:latest AS builder

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates iproute2 curl procps && rm -rf /var/lib/apt/lists/*

COPY --from=builder /work/octra/target/release/octravpn-node /usr/local/bin/octravpn-node

RUN useradd --system --user-group --home-dir /var/lib/octravpn --shell /bin/false octravpn \
    && install -d -m 0750 -o octravpn -g octravpn /var/lib/octravpn/state
WORKDIR /var/lib/octravpn
VOLUME ["/var/lib/octravpn/state"]
USER octravpn

EXPOSE 51820/udp 51821/tcp
ENTRYPOINT ["/usr/local/bin/octravpn-node"]
CMD ["--config", "/etc/octravpn/node.toml", "run"]
